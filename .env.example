# Variables d'environnement pour @nuxtjs/supabase
# Renommer ce fichier en .env et remplir les valeurs

# URL de votre projet Supabase
SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique (anon) de votre projet Supabase
SUPABASE_KEY=votre_cle_anon_publique

# ─── Backoffice Admin ─────────────────────────────────────────
# Clé service role (Supabase Dashboard > Settings > API)
# NE JAMAIS exposer cette clé côté client !
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# Emails autorisés à accéder au backoffice (séparés par virgule)
# Si vide → tout utilisateur connecté est admin (mode dev uniquement)
ADMIN_EMAILS=votre@email.com
